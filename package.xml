<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>packing_robot_module</name>
  <version>0.0.1</version>
  <description>SUBMIT_SEQUENCE/GET_SEQUENCE_STATUS TCP server bridging clients to doosan-robot2</description>
  <maintainer email="cook@euler-robotics.com">cook</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>dsr_common2</depend>
  <depend>dsr_msgs2</depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
